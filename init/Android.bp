cc_library_static {
    name: "libinit_rivena",
    recovery_available: true,
    shared_libs: ["libbase"],
    srcs: ["init_rivena.cpp"],
}

prebuilt_etc {
    name: "init.rivena.hw.rc",
    src: "init.rivena.hw.rc",
    sub_dir: "init",
    device_specific: true,
    recovery_available: true,
}

prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab.qcom",
    vendor: true,
    ramdisk_available: true,
}
